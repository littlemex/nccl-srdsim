# SPDX-License-Identifier: Apache-2.0
# Every upstream version this repository builds, tests or documents against. CI and the GPU recipe read
# this file, and ci/check_versions.sh fails when a document, a workflow or a script names a commit, an
# NCCL release or the NCCL wheel that is not here. Bash syntax: `. ./versions.env` defines the variables.

# NCCL releases the plugin is built and tested against, oldest first. Each needs its commit below,
# named NCCL_COMMIT_ followed by the tag with every character that is not a letter or digit as _.
NCCL_RELEASES="v2.31.2-1 v2.32.3-1 v2.32.6-1"
NCCL_COMMIT_v2_31_2_1=7b83616df3ae082a1f32bb74c27458bfe8153a13
NCCL_COMMIT_v2_32_3_1=12df1a11afad322be5a204a2db890161cbf8131d
NCCL_COMMIT_v2_32_6_1=ad2d192c1f279aefcaf340f67e07880b65a1116b
# The release used where one is enough: the CMake jobs, the GPU test, the GPU recipe.
NCCL_DEFAULT=v2.32.6-1
# Derived, not edited: the commit of NCCL_DEFAULT.
eval "NCCL_DEFAULT_COMMIT=\$NCCL_COMMIT_${NCCL_DEFAULT//[^A-Za-z0-9]/_}"
: "${NCCL_DEFAULT_COMMIT:?versions.env pins no commit for $NCCL_DEFAULT}"
# The NCCL wheel the GPU recipe installs; the same release as NCCL_DEFAULT.
NCCL_WHEEL=2.32.6

# The oldest RMA table the plugin exports: v14 is the first whose iputSignal carries the strong-signal
# flag the plugin implements, and every pinned release looks it up.
RMA_TABLE_MIN=14
# RMA table versions a pinned release defines that the plugin does not export yet, each with its issue.
# The export check fails when one of these is exported (remove it here) or when any other is missing.
RMA_TABLES_NOT_EXPORTED="17"   # https://github.com/littlemex/nccl-srdsim/issues/13

# CUDA toolkits the plugin is built against, as NVIDIA's Ubuntu package suffixes.
CUDA_TOOLKITS="12-8 13-0"
CUDA_DEFAULT=13-0
CUDA_KEYRING_DEB=cuda-keyring_1.1-1_all.deb
CUDA_KEYRING_SHA256=d2a6b11c096396d868758b86dab1823b25e14d70333f1dfa74da5ddaf6a06dba

GDRCOPY_TAG=v2.5.2
GDRCOPY_COMMIT=c91ad9f178e5fb729fc5b6dc62a77c3bb364d6c9

# The production RMA plugin for SRD, cited as the reference implementation.
AWS_OFI_NCCL_COMMIT=2475c4c736907e68ebeadb3848f31231ee4a44d0
